rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Custom email/password accounts live in appUsers. There is no Firebase Auth,
    // so rules cannot use request.auth. Access is by document id (email hash / uid).
    match /appUsers/{emailKey} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if true;
    }

    match /users/{userId} {
      allow read, create, update, delete: if true;

      match /{collection}/{document=**} {
        allow read, create, update, delete: if true;
      }
    }
  }
}
